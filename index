function rpScore(a){
  if (a === 'na') return '<span class="rp-na">해당 상황 없음</span>';
  if (!a) return '<span class="rp-na">-</span>';
  const n = +a, cls = n <= 2 ? 'lo' : 'ok';
  let s = '';
  for (let k = 1; k <= 4; k++) s += `<i class="${k <= n ? cls : ''}"></i>`;
  return `<span class="rp-sc">${s}<b class="${cls}">${n}</b></span>`;
}

function rpItemRows(list){
  return list.map(i => {
    const a = answers[i.code];
    const low = a === '1' || a === '2';
    return `<tr class="${low ? 'low' : ''}"><td class="c">${i.code}</td><td class="t">${esc(i.text)}</td><td class="s">${rpScore(a)}</td></tr>`;
  }).join('');
}

function buildReportBlocks(){
  const { hi, lo } = thresholds();
  const band = m => m >= hi ? 'good' : (m >= lo ? 'mid' : 'low');
  const zones = labels => `<div class="rz low" style="width:${pct(lo)}%">${labels ? '<span>성장 포인트</span>' : ''}</div><div class="rz mid" style="left:${pct(lo)}%;width:${pct(hi) - pct(lo)}%">${labels ? '<span>안정</span>' : ''}</div><div class="rz good" style="left:${pct(hi)}%;width:${100 - pct(hi)}%">${labels ? '<span>강점</span>' : ''}</div>`;
  const d = new Date();
  const dateStr = `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일`;
  const core = DOMAINS.filter(x => !x.self);
  const selfD = DOMAINS.find(x => x.self);
  const rows = core.map(dm => { const st = stats(itemsOf(dm)); return { dm, st, unreliable: st.na >= 3 }; });
  const blocks = [];

  blocks.push(`<div class="rp-cover">
    <p class="rp-kicker">Leadership Self-Assessment Report</p>
    <h1>리더십 역량 자기진단 리포트</h1>
    <dl class="rp-meta">
      <div><dt>진단일</dt><dd>${dateStr}</dd></div>
      <div><dt>응답 기준</dt><dd>최근 3개월 동안의 행동</dd></div>
      <div><dt>해석 기준</dt><dd>강점 ${hi.toFixed(1)} 이상 / 성장 포인트 ${lo.toFixed(1)} 미만</dd></div>
    </dl>
    <p class="rp-lead">각 영역 점수는 그 영역 문항에 답한 점수의 평균이에요(1.0~4.0). 1점에 가까울수록 거의 하지 않는 행동, 4점에 가까울수록 거의 항상 하는 행동이라는 뜻이에요.</p>
  </div>`);

  const sumRows = rows.map(({ dm, st }) => {
    if (st.mean == null) return '';
    const b = band(st.mean);
    return `<div class="rp-srow"><span class="rp-sname">${dm.id}. ${dm.name}</span><div class="rp-track">${zones(false)}<span class="rp-dot ${b}" style="left:${pct(st.mean)}%"></span></div><span class="rp-sval"><b>${st.mean.toFixed(2)}</b><em class="${b}">${BAND[b]}</em></span></div>`;
  }).join('');
  blocks.push(`<section><h2>한눈에 보기</h2>
    <div class="rp-srow rp-legend"><span class="rp-sname"></span><div class="rp-track">${zones(true)}</div><span></span></div>
    <div class="rp-srow rp-tickrow"><span></span><div class="rp-ticks"><span style="left:0">1</span><span style="left:33.33%">2</span><span style="left:66.67%">3</span><span style="left:100%">4</span></div><span></span></div>
    ${sumRows}
  </section>`);

  const valid = rows.filter(r => r.st.mean != null);
  const pool = valid.filter(r => !r.unreliable).length ? valid.filter(r => !r.unreliable) : valid;
  let find = '';
  if (pool.length) {
    const lowAbs = valid.filter(r => band(r.st.mean) === 'low');
    const max0 = Math.max(...pool.map(r => r.st.mean));
    const min = Math.min(...pool.map(r => r.st.mean));
    const lowest = pool.filter(r => r.st.mean - min < 0.1 && max0 - r.st.mean >= 0.1);
    const goodAbs = valid.filter(r => band(r.st.mean) === 'good');
    const max = Math.max(...pool.map(r => r.st.mean));
    const highest = pool.filter(r => max - r.st.mean < 0.1 && r.st.mean - min >= 0.1);
    const nm = list => list.map(r => `<b>${r.dm.name}(${r.st.mean.toFixed(2)})</b>`).join(', ');
    const ie = list => josa(list[list.length - 1].dm.name, '이에요', '예요');
    const flat = max0 - min < 0.1;
    find += `<p>${lowAbs.length ? `성장 포인트 구간에 든 영역은 ${nm(lowAbs)}${ie(lowAbs)}.` : '성장 포인트 구간에 든 영역은 없어요.'}</p>`;
    find += flat ? '<p>영역별 점수가 비슷해서 상대적으로 낮거나 높은 영역을 가리기 어려워요. 영역보다 1·2점으로 답한 문항을 먼저 살펴보세요.</p>'
      : `<p>상대적으로 가장 낮은 영역은 ${nm(lowest)}${ie(lowest)}.${lowest.length > 1 ? ' 점수 차이가 0.1점도 안 돼서 어느 쪽이 더 약하다고 단정하기 어려우니, 모두 우선 후보로 보세요.' : ''}</p>`;
    find += `<p>${goodAbs.length ? `강점 구간에 든 영역은 ${nm(goodAbs)}${ie(goodAbs)}.` : (flat ? '강점 구간에 든 영역은 없어요.' : `강점 구간에 든 영역은 없고, 상대적으로 가장 높은 영역은 ${nm(highest)}${ie(highest)}.`)}</p>`;
  }
  blocks.push(`<section><h2>핵심 발견</h2><div class="rp-box">${find}</div></section>`);

  rows.forEach(({ dm, st, unreliable }, idx) => {
    const b = st.mean == null ? null : band(st.mean);
    const subs = dm.subs.length > 1 ? dm.subs.map(s => {
      const ss = stats(s.items.map(([code]) => ALL.find(i => i.code === code)));
      return `${s.name} ${ss.mean == null ? '-' : ss.mean.toFixed(2)}`;
    }).join(' / ') : '';
    const notes = [];
    if (subs) notes.push(`하위 영역 평균: ${subs}`);
    if (st.na) notes.push(unreliable ? `해당 상황 없음 ${st.na}개로 참고용 점수예요` : `해당 상황 없음 ${st.na}개는 평균에서 제외했어요`);
    const head = idx === 0 ? `<h2>영역별 상세</h2><p class="rp-hint">1점이나 2점으로 답한 문항은 주황색으로 표시했어요. 영역 평균이 괜찮아도 이 문항들이 영역 안의 빈틈이에요.</p>` : '';
    blocks.push(`${head}<div class="rp-card">
      <div class="rp-card-head"><h3>${dm.id}. ${dm.name}</h3><span class="rp-sval">${b ? `<b>${st.mean.toFixed(2)}</b><em class="${b}">${BAND[b]}</em>` : '<b>-</b>'}</span></div>
      ${notes.length ? `<p class="rp-sub">${notes.join(' · ')}</p>` : ''}
      <table class="rp-items">${rpItemRows(itemsOf(dm))}</table>
    </div>`);
  });

  const sst = stats(itemsOf(selfD));
  const sMsg = selfMsg(sst.mean);
  blocks.push(`<section><h2>자기관리 점검</h2>
    <div class="rp-card"><div class="rp-card-head"><h3>자기관리 평균</h3><span class="rp-sval"><b>${sst.mean == null ? '-' : sst.mean.toFixed(2)}</b></span></div>
    <p class="rp-sub">리더십 역량이 아니라 감정 조절, 에너지 회복, 스스로 돌아보는 시간처럼 지금 나에게 얼마나 여유가 있는지를 보는 점수예요. ${sMsg}</p>
    <table class="rp-items">${rpItemRows(itemsOf(selfD))}</table></div>
  </section>`);

  const sig = ALL.filter(i => i.signal && answers[i.code] === 'na');
  blocks.push(`<section><h2>한 번 더 들여다볼 문항</h2>
    <p class="rp-hint">아래 문항에 “해당 상황 없음”으로 답했다면, 그런 일이 없었다기보다 팀원들이 나에게 말하지 않고 있는 것일 수도 있어요.</p>
    ${sig.length ? `<table class="rp-items">${rpItemRows(sig)}</table>` : '<p class="rp-plain">해당하는 문항이 없어요.</p>'}
  </section>`);

  blocks.push(`<section><h2>추천 교육 순서</h2><p class="rp-hint">한 번에 하나씩 듣고, 4~6주 정도 현장에서 실천해 본 뒤 다음 순서로 넘어가 보세요.</p>${recsReportHtml()}</section>`);
  blocks.push(`<section class="rp-guide"><h2>결과 활용 가이드</h2>
    <p><b>추천 교육은 문항을 기준으로 골랐어요.</b> 같은 영역이라도 어떤 행동이 비어 있는지에 따라 필요한 교육이 달라서, 영역 이름이 아니라 1·2점으로 답한 문항을 보고 과정을 연결했어요. 신청 전에 과정 소개를 보면서, 내가 낮게 답한 행동을 실제로 다루는지 한 번 더 확인해 보세요.</p>
    <p><b>자기관리 점수와 함께 보세요.</b> 자기관리 점수도 낮다면 스킬 교육보다 업무 부담 조정이나 회복 시간 확보가 먼저일 수 있어요.</p>
    <p><b>다시 진단해 보세요.</b> 교육을 듣고 3~6개월 뒤 같은 진단을 해보면 실제 행동이 얼마나 바뀌었는지 비교할 수 있어요.</p>
  </section>`);

  const refText = (document.querySelector('.refs > p') || {}).textContent || '';
  const refList = (document.querySelector('.refs ol') || {}).innerHTML || '';
  blocks.push(`<section class="rp-refs"><h2>이 진단지의 근거</h2><p>${esc(refText)}</p><ol>${refList}</ol></section>`);
  return blocks;
}

function layoutReport(){
  const host = document.createElement('div');
  host.className = 'rp-host';
  host.setAttribute('aria-hidden', 'true');
  document.body.appendChild(host);
  const pages = [];
  const newPage = () => {
    const p = document.createElement('div');
    p.className = 'rp-page';
    p.innerHTML = '<header class="rp-head"><span>리더십 역량 자기진단 리포트</span></header><div class="rp-body"></div><footer class="rp-foot"></footer>';
    host.appendChild(p); pages.push(p);
    return p.querySelector('.rp-body');
  };
  let body = newPage();
  buildReportBlocks().forEach(html => {
    const blk = document.createElement('div');
    blk.className = 'rp-block';
    blk.innerHTML = html;
    body.appendChild(blk);
    if (body.scrollHeight > body.clientHeight + 1 && body.children.length > 1) {
      body.removeChild(blk);
      body = newPage();
      body.appendChild(blk);
    }
  });
  pages.forEach((p, i) => {
    p.querySelector('.rp-foot').textContent = `${i + 1} / ${pages.length}`;
    if (i === 0) p.querySelector('.rp-head').style.visibility = 'hidden';
  });
  return { host, pages };
}

async function makeReportPdf(){
  const busy = document.createElement('div');
  busy.className = 'rp-busy';
  busy.innerHTML = '<b>리포트를 만드는 중이에요</b><small>잠시만 기다려 주세요</small>';
  document.body.appendChild(busy);
  const isIOS = /iP(hone|ad|od)/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const vv = (window.visualViewport && window.visualViewport.scale) || 1;
  let scale = isIOS ? 1 : Math.max(1, 2 / vv);

  let r = layoutReport();
  if (document.fonts && document.fonts.ready) { try { await document.fonts.ready; } catch (e) {} }
  await new Promise(res => setTimeout(res, 150));
  r.host.remove();
  r = layoutReport();
  const sx = window.scrollX, sy = window.scrollY;
  window.scrollTo(0, 0);
  try {
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF({ unit: 'mm', format: 'a4', orientation: 'portrait', compress: true });
    let fix = 1;
    const opts = sc => ({
      scale: sc, backgroundColor: '#ffffff', x: 0, y: 0, scrollX: 0, scrollY: 0,
      width: RP_W, height: RP_H, windowWidth: RP_W, windowHeight: RP_H, logging: false, useCORS: true,
      onclone: doc => {
        const m = doc.querySelector('meta[name="viewport"]');
        if (m) m.setAttribute('content', `width=${RP_W}, initial-scale=1`);
        const h = doc.querySelector('.rp-host');
        if (h) { h.style.left = '0px'; h.style.top = '0px'; }
        const t = doc.querySelector('[data-cap="1"]');
        if (t && fix !== 1) { t.style.transformOrigin = '0 0'; t.style.transform = `scale(${fix})`; }
      }
    });
    const shoot = async el => { el.setAttribute('data-cap', '1'); try { return await html2canvas(el, opts(scale)); } finally { el.removeAttribute('data-cap'); } };
    
    try {
      const cal = document.createElement('div');
      cal.className = 'rp-page';
      cal.style.position = 'relative';
      cal.innerHTML = '<i style="position:absolute;left:397px;top:561px;width:8px;height:8px;background:#ff00ff;display:block"></i>';
      r.host.appendChild(cal);
      await new Promise(res => requestAnimationFrame(() => requestAnimationFrame(res)));
      const cc = await shoot(cal);
      cal.remove();
      const ctx = cc.getContext('2d');
      const img = ctx.getImageData(0, 0, cc.width, cc.height).data;
      let fx = -1;
      for (let i = 0; i < img.length; i += 4) {
        if (img[i] > 230 && img[i + 1] < 40 && img[i + 2] > 230) { fx = (i / 4) % cc.width; break; }
      }
      const k = fx < 0 ? 1 : fx / (397 * scale);
      if (Math.abs(k - 1) > 0.05) fix = 1 / k;
      window.__pdfCal = `보정 ${k.toFixed(2)} · 배율 ${scale}`;
      cc.width = 0; cc.height = 0;
    } catch (e) {
      fix = 1;
    }

    for (let i = 0; i < r.pages.length; i++) {
      const canvas = await shoot(r.pages[i]);
      if (i > 0) pdf.addPage();
      pdf.addImage(canvas.toDataURL('image/jpeg', 0.9), 'JPEG', 0, 0, 210, 297);
      canvas.width = 0; canvas.height = 0;
    }
    return pdf.output('blob');
  } finally {
    r.host.remove();
    busy.remove();
    window.scrollTo(sx, sy);
  }
}

let readyPdf = null;
document.getElementById('pdfSave').addEventListener('click', async () => {
  if (!readyPdf) return;
  const status = document.getElementById('pdfStatus');
  const file = new File([readyPdf.blob], readyPdf.fname, { type: 'application/pdf' });
  try {
    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      await navigator.share({ files: [file], title: '리더십 셀프 체크 리포트' });
      status.textContent = '저장하거나 공유했어요. 파일 앱에서 “' + readyPdf.fname + '”을 찾아보세요.';
      return;
    }
  } catch (err) {
    if (err && err.name === 'AbortError') { status.textContent = '저장을 취소했어요. 다시 누르면 공유 창이 열려요.'; return; }
  }
  const url = URL.createObjectURL(readyPdf.blob);
  const a = document.createElement('a');
  a.href = url; a.download = readyPdf.fname;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 60000);
  status.textContent = 'PDF 리포트 다운로드를 시작했어요.';
});

const pdfBtn = document.getElementById('pdfBtn');
pdfBtn.addEventListener('click', async () => {
  const status = document.getElementById('pdfStatus');
  if (!window.jspdf || !window.html2canvas) { status.textContent = 'PDF 도구를 불러오지 못했어요. 페이지를 새로고침한 뒤 다시 시도해 주세요.'; return; }
  pdfBtn.disabled = true; pdfBtn.textContent = '리포트 만드는 중…'; status.textContent = '';
  try {
    const blob = await makeReportPdf();
    const d = new Date();
    const fname = `리더십역량진단_리포트_${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}.pdf`;
    const dl = await downloadsReady;
    if (dl) {
      try {
        await dl.save({ filename: fname, data: blob });
        status.textContent = 'PDF 리포트를 저장했어요.' + (testOn && window.__pdfCal ? ` (${window.__pdfCal})` : '');
      } catch (err) {
        const code = err && err.code;
        status.textContent = code === 'declined' ? '저장을 취소했어요.'
          : code === 'rate_limited' ? '저장 창이 이미 열려 있어요. 잠시 후 다시 눌러 주세요.'
          : 'PDF를 저장하지 못했어요. 잠시 후 다시 시도해 주세요.';
      }
    } else if (/iP(hone|ad|od)/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) {
      readyPdf = { blob, fname };
      document.getElementById('pdfSave').hidden = false;
      status.textContent = '리포트가 준비됐어요. 아래 버튼을 눌러 “파일에 저장”을 고르면 파일 앱에 저장돼요.';
    } else {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = fname;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 5000);
      status.textContent = 'PDF 리포트 다운로드를 시작했어요.';
    }
  } catch (e) {
    status.textContent = 'PDF를 만드는 중에 문제가 생겼어요. 다시 시도해 주세요.';
  } finally {
    pdfBtn.disabled = false; pdfBtn.textContent = 'PDF 리포트 저장하기';
  }
});

