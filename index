<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>리더십 셀프 체크 · 리더십 역량 자기진단</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@700&family=IBM+Plex+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F2F0EB; --surface:#FFFFFF; --ink:#4A4642; --body:#5C5853; --muted:#6B665F; --line:#E0DDD6;
  --chip:#ECEAE5; --opt:#F7F6F3; --panel:#E9E6E0;
  --primary:#4A4642; --primary-ink:#FFFFFF; --primary-soft:#E6E4DF; --primary-hover:#36322E;
  --good:#4A4642; --good-soft:#E6E4DF; --good-ink:#4A4642;
  --mid:#8F8A80; --mid-soft:#ECEAE5; --mid-ink:#57534B; --mid-bar:#ADA89F;
  --low:#E4572E; --low-soft:#FBE2D8; --low-ink:#9C3415; --low-bg:#FDF1EC;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#1C1B19; --surface:#262421; --ink:#EDE9E3; --body:#CFC9C0; --muted:#A8A198; --line:#3A3733;
    --chip:#302E2A; --opt:#2C2A27; --panel:#2A2825;
    --primary:#EDE9E3; --primary-ink:#1C1B19; --primary-soft:#33312D; --primary-hover:#FFFFFF;
    --good:#EDE9E3; --good-soft:#33312D; --good-ink:#EDE9E3;
    --mid:#A8A198; --mid-soft:#2F2D29; --mid-ink:#CFC9C0; --mid-bar:#77716A;
    --low:#F07A52; --low-soft:#3D2620; --low-ink:#F4A487; --low-bg:#2E211C;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#1C1B19; --surface:#262421; --ink:#EDE9E3; --body:#CFC9C0; --muted:#A8A198; --line:#3A3733;
  --chip:#302E2A; --opt:#2C2A27; --panel:#2A2825;
  --primary:#EDE9E3; --primary-ink:#1C1B19; --primary-soft:#33312D; --primary-hover:#FFFFFF;
  --good:#EDE9E3; --good-soft:#33312D; --good-ink:#EDE9E3;
  --mid:#A8A198; --mid-soft:#2F2D29; --mid-ink:#CFC9C0; --mid-bar:#77716A;
  --low:#F07A52; --low-soft:#3D2620; --low-ink:#F4A487; --low-bg:#2E211C;
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
[hidden]{display:none!important}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 96px)}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:'IBM Plex Sans KR','Apple SD Gothic Neo','Malgun Gothic',system-ui,sans-serif;
  line-height:1.65;word-break:keep-all;-webkit-text-size-adjust:100%}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--surface)}
button{font:inherit}
.serif{font-family:'Gowun Batang','Nanum Myeongjo',serif;font-weight:700}
.wrap{max-width:720px;margin:0 auto;padding:0 20px}
main{padding:56px 0 96px}

/* progress bar */
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--surface);border-bottom:1px solid var(--line)}
.bar .wrap{padding-top:14px;padding-bottom:14px;display:flex;flex-direction:column;gap:10px}
.bar-top{display:flex;justify-content:space-between;gap:12px;font-size:13px;color:var(--muted);flex-wrap:wrap}
.bar-top b{color:var(--low-ink);font-weight:600}
.segs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:6px}
.segs span{height:6px;border-radius:3px;background:var(--line);transition:background .2s}
.segs span.done{background:var(--primary)}
.segs span.cur{background:var(--low)}

/* shared */
.chip{display:inline-block;font-size:13px;font-weight:600;color:var(--ink);background:var(--primary-soft);padding:6px 12px;border-radius:999px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:999px;font-size:16px;font-weight:600;cursor:pointer;min-height:48px;text-decoration:none;transition:background .15s,border-color .15s}
.btn-primary{background:var(--primary);color:var(--primary-ink);border:0;padding:14px 36px}
.btn-primary:hover{background:var(--primary-hover)}
.btn-primary:disabled{opacity:.6;cursor:progress}
.btn-big{padding:17px 48px;font-size:17px}
.btn-ghost{background:var(--surface);color:var(--ink);border:1px solid var(--line);padding:12px 28px}
.btn-ghost:hover{border-color:var(--mid)}
.btn-small{min-height:40px;padding:8px 18px;font-size:14px;font-weight:500}
.link{background:none;border:0;padding:6px 4px;min-height:44px;display:inline-flex;align-items:center;color:var(--muted);text-decoration:underline;text-underline-offset:3px;cursor:pointer;font-size:14px}
button,label,a{-webkit-tap-highlight-color:transparent}
.btn:focus-visible,.link:focus-visible,summary:focus-visible{outline:2px solid var(--low);outline-offset:3px}
.card{background:var(--surface);border-radius:20px;padding:24px}
h1:focus,h2:focus{outline:none}

/* intro */
.intro{display:flex;flex-direction:column;gap:44px}
.hero-intro{display:flex;flex-direction:column;gap:18px;align-items:flex-start}
.hero-intro h1{margin:0;font-size:clamp(32px,6.4vw,44px);line-height:1.3}
.lead{margin:0;font-size:17px;line-height:1.7;color:var(--body)}
.facts{display:flex;gap:10px;flex-wrap:wrap}
.facts > span{display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 14px;font-size:14px}
.facts svg{flex:0 0 auto}
.sec{display:flex;flex-direction:column;gap:16px}
.sec h2{margin:0;font-size:18px;font-weight:600}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.stepcard{background:var(--surface);border-radius:16px;padding:16px 18px;display:flex;gap:12px;align-items:center;font-size:14px;line-height:1.4}
.num{width:30px;height:30px;border-radius:50%;background:var(--primary-soft);color:var(--ink);font-weight:600;font-size:14px;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.num.alt{background:var(--low-soft);color:var(--low-ink)}
.tip{background:var(--surface);border-radius:16px;padding:20px;display:flex;flex-direction:column;gap:8px}
.tip b{font-size:15px;font-weight:600}
.tip span{font-size:14px;line-height:1.6;color:var(--body)}
.audience{background:var(--panel);border-radius:16px;padding:20px 22px;display:flex;flex-direction:column;gap:10px;font-size:14px;line-height:1.7;color:var(--body)}
.audience p{margin:0}
.audience b{color:var(--ink)}
.topcta{display:flex;align-items:center;gap:16px;flex-wrap:wrap;padding-top:6px}
.topcta span{font-size:13px;color:var(--muted)}
.cta{display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center}
.cta .note{font-size:13px;color:var(--muted);margin:0}
.tools{display:flex;gap:18px;justify-content:center;flex-wrap:wrap}

/* question pages */
section.domain{display:flex;flex-direction:column;gap:28px}
.dhead{display:flex;gap:18px;align-items:flex-start}
.dnum{width:52px;height:52px;border-radius:16px;background:var(--primary-soft);color:var(--ink);font-family:'Gowun Batang',serif;font-size:24px;font-weight:700;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.dnum.alt{background:var(--low-soft);color:var(--low-ink)}
.dtitle{margin:0 0 6px;font-size:clamp(26px,5vw,30px);line-height:1.3}
.ddesc{margin:0;font-size:15px;line-height:1.7;color:var(--body)}
.dmeta{margin:6px 0 0;font-size:13px;color:var(--muted)}
h3.sub{margin:8px 0 -14px;font-size:14px;font-weight:600;color:var(--muted);letter-spacing:.02em}
.items{display:flex;flex-direction:column;gap:12px}
fieldset.item{border:1.5px solid transparent;background:var(--surface);border-radius:18px;margin:0;padding:22px 24px;min-width:0;display:flex;flex-direction:column;gap:16px;transition:border-color .2s}
fieldset.item.missing{border-color:var(--low)}
legend{float:left;width:100%;padding:0;display:flex;gap:12px;font-size:16px;line-height:1.6;font-weight:500;margin:0}
legend + *{clear:both}
.code{font-size:12px;color:var(--muted);background:var(--chip);border-radius:6px;padding:0 8px;height:22px;line-height:22px;flex:0 0 auto;margin-top:2px;font-variant-numeric:tabular-nums}
.opts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.opt{position:relative;display:block}
.opt input{position:absolute;opacity:0;width:1px;height:1px;margin:0}
.opt span{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;height:100%;min-height:64px;text-align:center;padding:10px 4px;border:1px solid var(--line);border-radius:14px;background:var(--opt);color:var(--body);font-size:13px;line-height:1.3;cursor:pointer;user-select:none;transition:background .15s,border-color .15s}
.opt span b{font-size:18px;font-weight:600;color:var(--ink)}
.scale{display:flex;flex-direction:column;gap:6px}
.ends,.picked{display:none}
.ends{justify-content:space-between;font-size:12px;color:var(--muted)}
.picked{margin:0;font-size:12px;color:var(--muted);text-align:center;min-height:18px}
.opt span:hover{border-color:var(--mid)}
.opt input:checked + span{background:var(--primary);border-color:var(--primary);color:var(--primary-ink)}
.opt input:checked + span b{color:inherit}
.opt input:focus-visible + span{outline:2px solid var(--low);outline-offset:2px}
.opt.na{align-self:flex-start}
.opt.na span{min-height:44px;flex-direction:row;padding:7px 14px;border:1px dashed var(--mid);background:transparent;border-radius:999px;color:var(--muted)}
.opt.na input:checked + span{border-style:solid;background:var(--mid);border-color:var(--mid);color:var(--primary-ink)}
.miss-msg{display:none;margin:0;font-size:13px;color:var(--low-ink)}
fieldset.item.missing .miss-msg{display:block}
.pager{display:flex;justify-content:space-between;gap:12px;margin-top:36px}
.notice{margin:14px 0 0;color:var(--low-ink);font-size:14px;min-height:1.4em;text-align:center}

/* results */
#results{display:flex;flex-direction:column;gap:40px}
.rhead{display:flex;flex-direction:column;gap:14px;align-items:flex-start}
.rdate{font-size:13px;color:var(--muted);padding-top:6px}
.rhead h1{margin:0;font-size:clamp(28px,5.6vw,38px);line-height:1.35}
.hero{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.hcard{border-radius:20px;padding:24px;display:flex;flex-direction:column;gap:8px}
.hcard.good{background:var(--primary);color:var(--primary-ink)}
.hcard.good p{color:inherit;opacity:.88}
.hcard.low{background:var(--low-soft)}
.hlabel{font-size:13px;font-weight:600}
.hcard.good .hlabel,.hcard.good .hscore{color:inherit;opacity:.8}
.hcard.low .hlabel,.hcard.low .hscore{color:var(--low-ink)}
.hname{font-family:'Gowun Batang',serif;font-weight:700;font-size:24px;line-height:1.35}
.hscore{font-size:14px}
.hcard p{margin:0;font-size:14px;line-height:1.6;color:var(--body)}
.chart h2,.lows h2,.duo h2{margin:0;font-size:18px;font-weight:600}
.chart{display:flex;flex-direction:column;gap:4px;padding:28px 28px 14px}
.chart h2{margin-bottom:12px}
.crow{display:grid;grid-template-columns:220px minmax(0,1fr) 120px;gap:16px;align-items:center;padding:14px 0;border-top:1px solid var(--line)}
.crow.legend{border-top:0;padding:0 0 6px}
.cname{font-size:15px;font-weight:500;display:flex;flex-direction:column;gap:2px}
.cname small{font-size:12px;font-weight:400;color:var(--muted);line-height:1.4}
.cname small.warn{color:var(--low-ink)}
.zones{display:flex;height:28px;border-radius:10px;overflow:hidden;font-size:12px;font-weight:600}
.zones span{display:flex;align-items:center;justify-content:center;white-space:nowrap;overflow:hidden}
.zones .low{background:var(--low-soft);color:var(--low-ink)}
.zones .mid{background:var(--mid-soft);color:var(--mid-ink)}
.zones .good{background:var(--good);color:var(--primary-ink)}
.ctrack{position:relative;height:12px;border-radius:6px;background:var(--chip);margin:0 9px}
.crow.legend .zones{margin:0 9px}
.cfill{position:absolute;left:-9px;top:0;bottom:0;border-radius:6px;transition:width .3s}
@media (min-width:641px){.cname small{white-space:nowrap}}
.cdot{position:absolute;top:50%;width:18px;height:18px;margin:-9px 0 0 -9px;border-radius:50%;background:var(--surface);border:4px solid}
.cfill.good{background:var(--good)} .cdot.good{border-color:var(--good)}
.cfill.mid{background:var(--mid-bar)} .cdot.mid{border-color:var(--mid-bar)}
.cfill.low{background:var(--low)} .cdot.low{border-color:var(--low)}
.cval{display:flex;justify-content:flex-end;align-items:center;gap:8px}
.cval b{font-size:17px;font-variant-numeric:tabular-nums}
.badge{font-size:12px;font-weight:600;padding:3px 9px;border-radius:999px;white-space:nowrap}
.badge.good{background:var(--good);color:var(--primary-ink)}
.badge.mid{background:var(--mid-soft);color:var(--mid-ink)}
.badge.low{background:var(--low-soft);color:var(--low-ink)}
.lows{display:flex;flex-direction:column;gap:14px;padding:28px}
.lows .hint,.duo .hint{margin:4px 0 0;font-size:14px;color:var(--muted);line-height:1.6}
.lgroup{background:var(--low-bg);border-radius:16px;padding:6px 18px}
.lghead{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:12px 0 8px;color:var(--low-ink)}
.lghead b{font-size:15px;font-weight:600}
.lghead span{font-size:13px}
.litem{display:grid;grid-template-columns:40px minmax(0,1fr) 40px;gap:12px;align-items:start;padding:12px 0;border-top:1px solid var(--low-soft)}
.litem .c{font-size:12px;color:var(--muted);padding-top:3px;font-variant-numeric:tabular-nums}
.litem .d{display:block;font-size:12px;color:var(--low-ink);font-weight:600}
.litem .t{font-size:15px;line-height:1.55}
.litem .p{font-size:15px;font-weight:700;color:var(--low-ink);text-align:right}
.empty{margin:0;font-size:14px;color:var(--muted)}
.duo{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.duo .card{display:flex;flex-direction:column;gap:8px}
.duo .lbl{font-size:13px;font-weight:600;color:var(--muted)}
.duo .big{display:flex;align-items:baseline;gap:8px}
.duo .big b{font-family:'Gowun Batang',serif;font-size:30px}
.duo p{margin:0;font-size:14px;line-height:1.6;color:var(--body)}
.mini{list-style:none;margin:6px 0 0;padding:0;display:flex;flex-direction:column;gap:6px}
.mini li{display:grid;grid-template-columns:36px minmax(0,1fr) 28px;gap:8px;font-size:13px;line-height:1.5;color:var(--body)}
.mini li .c{color:var(--muted)}
.mini li .p{text-align:right;font-weight:600;color:var(--ink)}
.rcta{display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center;padding-top:8px}
.rcta p{margin:0;font-size:15px;color:var(--body)}
.pdfstatus{font-size:14px;color:var(--muted);min-height:1.4em}

/* refs */
.recs{display:flex;flex-direction:column;gap:18px;padding:28px}
.recs h2{margin:0;font-size:18px;font-weight:600}
.recs .hint{margin:4px 0 0;font-size:14px;color:var(--muted);line-height:1.6}
.rstep{border-top:1px solid var(--line);padding-top:18px;display:flex;flex-direction:column;gap:12px}
.rstep.first{border-top:0;padding-top:0}
.rshead{display:flex;gap:12px;align-items:flex-start}
.rnum{width:30px;height:30px;border-radius:50%;background:var(--chip);color:var(--ink);font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.rstep.first .rnum{background:var(--low);color:#FFFFFF}
.rshead b{display:block;font-size:16px;font-weight:600;line-height:1.4}
.rshead small{display:block;font-size:13px;color:var(--muted);margin-top:2px;line-height:1.5}
.rshead small.rwhy{color:var(--low-ink)}
.ropts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding-left:42px}
.ropts.one{grid-template-columns:minmax(0,1fr)}
.copt{background:var(--opt);border:1px solid var(--line);border-radius:14px;padding:14px 16px;display:flex;flex-direction:column;gap:4px}
.ctag{font-size:12px;font-weight:600;color:var(--muted)}
.cname{font-size:15px;font-weight:600;color:var(--ink);line-height:1.45}
a.cname{text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--mid)}
.cmeta{font-size:13px;color:var(--body);line-height:1.5}
.cbadge{align-self:flex-start;font-size:12px;font-weight:600;padding:2px 9px;border-radius:999px;background:var(--primary-soft);color:var(--ink);margin-top:4px}
.clink{font-size:13px;font-weight:600;color:var(--ink);text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--mid);margin-top:4px}
.rnote{margin:0;font-size:12px;color:var(--muted);line-height:1.6}
@media (max-width:640px){.ropts{grid-template-columns:minmax(0,1fr);padding-left:0}.recs{padding:22px 18px}}
.refs{margin-top:72px;padding-top:32px;border-top:1px solid var(--line)}
.refs h2{font-size:18px;margin:0 0 10px;font-weight:600}
.refs > p{color:var(--body);font-size:14px;margin:0 0 16px;line-height:1.7}
.refs details{margin:10px 0;background:var(--surface);border-radius:14px;padding:14px 18px}
.refs summary{cursor:pointer;font-weight:600;font-size:15px}
.tbl{overflow-x:auto;margin-top:10px}
.tbl table{border-collapse:collapse;width:100%;min-width:540px;font-size:14px}
.tbl th,.tbl td{text-align:left;vertical-align:top;padding:9px 10px;border-top:1px solid var(--line)}
.tbl th{color:var(--muted);font-weight:600;border-top:0}
.tbl td:nth-child(2){white-space:nowrap;font-variant-numeric:tabular-nums;color:var(--muted)}
.refs ol{margin:10px 0 0;padding-left:1.4em;font-size:13px;color:var(--body)}
.refs ol li{margin:6px 0}
.privacy{margin-top:32px}
.privacy h2{font-size:18px;margin:0 0 10px;font-weight:600}
.privacy ul{margin:0;padding:16px 18px 16px 34px;background:var(--surface);border-radius:14px;font-size:14px;line-height:1.7;color:var(--body)}
.privacy li{margin:4px 0}
.tools a.link{text-decoration:underline}
.privacy-inline{width:100%;max-width:560px;text-align:left}
.privacy-inline ul{margin:4px 0 0;padding:16px 18px 16px 34px;background:var(--surface);border-radius:14px;font-size:14px;line-height:1.7;color:var(--body)}
.privacy-inline li{margin:4px 0}

@media (max-width:640px){
  main{padding:36px 0 72px}
  .grid3{grid-template-columns:repeat(2,minmax(0,1fr))}
  .tips{grid-template-columns:minmax(0,1fr)}
  .hero,.duo{grid-template-columns:minmax(0,1fr)}
  fieldset.item{padding:18px 16px}
  .ends{display:flex}
  .picked{display:block}
  .opt span{min-height:52px;padding:6px 2px}
  .opt span b{font-size:19px}
  .opt span small{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .crow{grid-template-columns:minmax(0,1fr) auto;gap:8px 12px}
  .crow .cname{grid-column:1}
  .crow .cval{grid-column:2;grid-row:1}
  .crow .ctrack{grid-column:1 / -1}
  .crow.legend{grid-template-columns:minmax(0,1fr)}
  .crow.legend > div:empty{display:none}
  .chart,.lows{padding:22px 18px}
  .dhead{gap:14px}
  .dnum{width:44px;height:44px;font-size:20px;border-radius:14px}
}
@media (prefers-reduced-motion: reduce){*{transition:none!important}}
@media (max-width:360px){
  .stepcard{padding:12px;gap:10px;font-size:13px}
  .num{width:26px;height:26px;font-size:13px}
  .cval .badge{padding:3px 7px}
  .crow{gap:6px 8px}
}
.rp-host{position:fixed;left:0;top:0;width:794px;pointer-events:none;z-index:2147483000}
.rp-busy{position:fixed;inset:0;z-index:2147483600;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:var(--ink);font-size:15px;text-align:center;padding:24px}
.rp-busy small{color:var(--muted);font-size:13px}
