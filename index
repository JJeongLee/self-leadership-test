function computeRecs(){
  const { lo } = thresholds();
  const selfD = DOMAINS.find(d => d.self);
  const lowOf = its => its.filter(i => answers[i.code] === '1' || answers[i.code] === '2');
  const scored = RECS.map(t => {
    const its = t.items.map(c => ALL.find(i => i.code === c)).filter(Boolean);
    const lows = lowOf(its);
    const sev = lows.reduce((sum, i) => sum + (3 - +answers[i.code]), 0);
    const nums = its.map(i => answers[i.code]).filter(a => a && a !== 'na').map(Number);
    const avg = nums.length ? nums.reduce((a, b) => a + b, 0) / nums.length : 9;
    const dom = its[0].domain;
    const dm = stats(itemsOf(dom)).mean;
    return { t, its, lows, sev, avg, dom, dm: dm == null ? 9 : dm };
  });

  const steps = [];
  const sm = stats(itemsOf(selfD)).mean;
  const selfRow = scored.find(x => x.dom.self);
  if (sm != null && sm < lo && selfRow) {
    steps.push({ ...selfRow, why: '자기관리 점수가 낮게 나왔어요. 다른 교육보다 먼저, 지치지 않고 일할 여유를 회복하는 것부터 권해요.' });
  }

  let candidates = scored.filter(x => !x.dom.self && x.sev > 0);
  candidates.sort((a, b) => (a.dm - b.dm) || (b.sev - a.sev) || (a.avg - b.avg));

  if (!candidates.length && steps.length < 3) {
    candidates = scored.filter(x => !x.dom.self && x.avg < 3.5)
                       .sort((a, b) => (a.avg - b.avg) || (a.dm - b.dm));
  }

  for (const x of candidates) {
    if (steps.length >= 3) break;
    if (!steps.some(s => s.t.id === x.t.id)) {
      const isFirst = steps.length === 0;
      steps.push({
        ...x,
        why: isFirst
          ? (x.sev ? '가장 낮은 영역에서 1·2점으로 답한 문항이 가장 많은 주제라, 여기부터 시작하는 게 효과가 커요.' : '1·2점 문항은 없지만, 상대적으로 가장 덜 하고 있는 행동이에요.')
          : ''
      });
    }
  }

  return steps;
}
