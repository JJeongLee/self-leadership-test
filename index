const ALL = [];
DOMAINS.forEach(d => d.subs.forEach(s => s.items.forEach(([code,text,f='']) => {
  ALL.push({ code, text, na:f.includes('n'), signal:f.includes('s'), domain:d });
})));
const itemsOf = d => ALL.filter(i => i.domain === d);

let answers = {};
try { const raw = localStorage.getItem(KEY); if (raw) answers = JSON.parse(raw) || {}; } catch(e) { answers = {}; }
try { if (!localStorage.getItem(KEY + ':pm2')) { ['2-1','2-2','2-3','2-4','2-7'].forEach(k => delete answers[k]); localStorage.setItem(KEY, JSON.stringify(answers)); localStorage.setItem(KEY + ':pm2', '1'); } } catch(e) {}
function save(){ try { localStorage.setItem(KEY, JSON.stringify(answers)); } catch(e) {} }

const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function josa(word, withB, withoutB){
  const ch = String(word).replace(/[^가-힣]/g, '').slice(-1);
  if (!ch) return withB;
  return ((ch.charCodeAt(0) - 0xAC00) % 28) ? withB : withoutB;
}
const hasLowItem = d => itemsOf(d).some(i => answers[i.code] === '1' || answers[i.code] === '2');
let page = 0;
const LAST = DOMAINS.length;

function renderForm(){
  document.getElementById('stepCards').innerHTML = DOMAINS.map((d, di) =>
    `<div class="stepcard"><span class="num${d.self ? ' alt' : ''}">${di + 1}</span><span>${d.name}</span></div>`).join('');
  document.getElementById('factCount').textContent = `${ALL.length}문항`;
  document.getElementById('form').innerHTML = DOMAINS.map((d, di) => {
    const subs = d.subs.map(s => {
      const head = s.name ? `<h3 class="sub">${s.name}</h3>` : '';
      const items = s.items.map(([code, text, f='']) => {
        const opts = LABELS.map((l, i) => `<label class="opt"><input type="radio" name="q${code}" value="${i + 1}"><span><b>${i + 1}</b><small>${l}</small></span></label>`).join('');
        const na = f.includes('n') ? `<label class="opt na"><input type="radio" name="q${code}" value="na"><span>해당 상황 없음</span></label>` : '';
        return `<fieldset class="item" id="f${code}"><legend><span class="code">${code}</span><span class="txt">${esc(text)}</span></legend><div class="scale"><div class="ends" aria-hidden="true"><span>거의 안 한다</span><span>거의 항상 한다</span></div><div class="opts">${opts}</div><p class="picked" aria-hidden="true"></p></div>${na}<p class="miss-msg">이 문항에 아직 답하지 않았어요.</p></fieldset>`;
      }).join('');
      return `${head}<div class="items">${items}</div>`;
    }).join('');
    return `<section class="domain" data-page="${di + 1}" hidden>
      <div class="dhead"><span class="dnum${d.self ? ' alt' : ''}">${di + 1}</span><div><h1 class="dtitle serif">${d.name}</h1><p class="ddesc">${DESC[d.id] || ''}</p><p class="dmeta">${itemsOf(d).length}문항</p></div></div>
      ${subs}</section>`;
  }).join('');
  syncRadios();
}

function setPicked(code){
  const f = document.getElementById('f' + code);
  const el = f && f.querySelector('.picked');
  if (!el) return;
  const a = answers[code];
  el.textContent = a && a !== 'na' ? `선택: ${LABELS[+a - 1]}` : '';
}
function syncRadios(){
  ALL.forEach(it => {
    document.querySelectorAll(`input[name="q${it.code}"]`).forEach(r => { r.checked = (answers[it.code] === r.value); });
    setPicked(it.code);
  });
  updateProgress();
}

function updateProgress(){
  const done = ALL.filter(i => answers[i.code]).length;
  document.getElementById('countLine').textContent = `지금까지 ${done}문항 답했어요`;
  document.getElementById('segs').innerHTML = DOMAINS.map((d, i) => {
    const complete = itemsOf(d).every(x => answers[x.code]);
    return `<span class="${page === i + 1 ? 'cur' : (complete ? 'done' : '')}"></span>`;
  }).join('');
  const sb = document.getElementById('startBtn');
  const sl = done === 0 ? '진단 시작하기' : (done === ALL.length ? '결과 보기' : '이어서 하기');
  if (sb) sb.textContent = sl;
  const rb = document.getElementById('resetBtn');
  if (rb) rb.hidden = done === 0;
  const sb2 = document.getElementById('startBtn2');
  if (sb2) sb2.textContent = sl;
}

document.getElementById('form').addEventListener('change', e => {
  const t = e.target;
  if (t.type !== 'radio') return;
  const code = t.name.slice(1);
  answers[code] = t.value;
  document.getElementById('f' + code).classList.remove('missing');
  setPicked(code);
  save(); updateProgress();
});

function stats(items){
  let sum = 0, n = 0, na = 0;
  items.forEach(it => {
    const a = answers[it.code];
    if (a === 'na') na++;
    else if (a) { sum += +a; n++; }
  });
  return { mean: n ? sum / n : null, n, na };
}

const TH = { hi: 3.5, lo: 2.5 };
function thresholds(){ return TH; }
const pct = m => ((m - 1) / 3 * 100);
function selfMsg(mean){
  if (mean == null) return '';
  const low = mean < TH.lo;
  const SLAB = { 'S-1': '평정 유지', 'S-2': '에너지 회복', 'S-3': '스스로 돌아보기' };
  const weak = ALL.filter(i => i.domain.self && (answers[i.code] === '1' || answers[i.code] === '2')).map(i => `‘${SLAB[i.code] || i.code}’(${i.code}, ${answers[i.code]}점)`);
  let m = low
    ? '지금은 리더 역할을 해낼 마음의 여유와 에너지가 부족한 상태일 수 있어요. 위에서 점수가 낮게 나온 영역이 있다면, 방법을 몰라서라기보다 지치고 바빠서 못 하고 있는 것일 수 있어요. 이럴 때는 리더십 스킬 교육을 듣기 전에 업무 부담을 줄이거나 회복할 시간을 먼저 챙기는 게 도움이 돼요. 그래서 추천 교육의 첫 순서에 회복을 돕는 과정을 넣어 두었어요.'
    : '지금은 리더 역할을 해낼 마음의 여유와 에너지가 어느 정도 있는 상태예요. 그래서 위에서 점수가 낮게 나온 영역이 있다면, 바빠서 못 했다기보다 아직 방법을 잘 모르거나 습관이 되지 않았을 가능성이 커요. 이런 부분은 교육이나 연습으로 채우기 좋아요.';
  if (!low && weak.length) m += ` 다만 평균과 달리 ${weak.join(', ')} 문항은 낮게 답했어요. 이 부분은 따로 챙겨 보세요.`;
  return m;
}

function renderResults(){
  const { hi, lo } = thresholds();
  const band = m => m >= hi ? 'good' : (m >= lo ? 'mid' : 'low');
  const core = DOMAINS.filter(d => !d.self);
  const selfD = DOMAINS.find(d => d.self);
  const rows = core.map(d => {
    const st = stats(itemsOf(d));
    const subs = d.subs.length > 1 ? d.subs.map(s => {
      const ss = stats(s.items.map(([code]) => ALL.find(i => i.code === code)));
      return `${s.name} ${ss.mean == null ? '-' : ss.mean.toFixed(2)}`;
    }).join(' · ') : '';
    return { d, st, unreliable: st.na >= 3, subs };
  });
  const valid = rows.filter(r => r.st.mean != null);
  const reliable = valid.filter(r => !r.unreliable);
  const pool = reliable.length ? reliable : valid;

  let hero = '';
  if (pool.length) {
    const max = Math.max(...pool.map(r => r.st.mean));
    const min = Math.min(...pool.map(r => r.st.mean));
    const names = l => l.map(r => r.d.name).join(', ');
    const scores = l => l.length === 1 ? `${l[0].st.mean.toFixed(2)}점 · ${BAND[band(l[0].st.mean)]}` : l.map(r => `${r.st.mean.toFixed(2)}점(${BAND[band(r.st.mean)]})`).join(' / ');
    const lowCount = ALL.filter(i => !i.domain.self && (answers[i.code] === '1' || answers[i.code] === '2')).length;
    if (max - min < 0.1) {
      const fb = band(min) === band(max) ? band(min) : 'mid';
      const fname = fb === 'good' ? '모든 영역이 고르게 높아요' : (fb === 'low' ? '전반적으로 점수가 낮게 나왔어요' : '영역별 점수가 비슷해요');
      const fmsg = lowCount
        ? '영역끼리 비교하기보다, 아래에서 1·2점으로 답한 문항을 먼저 살펴보는 게 더 도움이 돼요.'
        : '1·2점으로 답한 문항도 없어서 지금은 뚜렷하게 비어 있는 행동이 없어요. 3점으로 답한 문항 중 더 자주 하고 싶은 행동을 골라 보세요.';
      hero = `<div class="hcard ${fb === 'low' ? 'low' : 'good'}"><span class="hlabel">고르게 나온 결과</span><span class="hname">${fname}</span><p>${fmsg}</p></div>`;
    } else {
      const top = pool.filter(r => max - r.st.mean < 0.1 && r.st.mean - min >= 0.1);
      const bottom = pool.filter(r => r.st.mean - min < 0.1 && max - r.st.mean >= 0.1);
      const tb = band(max), bb = band(min);
      const topMsg = (tb === 'good' ? '이 영역의 행동이 이미 습관처럼 자리 잡혀 있어요. 이 힘을 다른 영역에도 활용해 보세요.' : '아직 강점 구간은 아니지만, 다른 영역보다 꾸준히 하고 있는 행동이에요.')
        + (top.length > 1 ? ' 점수 차이가 0.1점도 안 돼서 함께 담았어요.' : '')
        + (top.some(r => hasLowItem(r.d)) ? ' 다만 이 영역 안에서도 1·2점으로 답한 문항이 있으니 아래에서 함께 확인해 보세요.' : '');
      const selfLow = (() => { const m = stats(itemsOf(DOMAINS.find(d => d.self))).mean; return m != null && m < lo; })();
      const botMsg = (bb === 'low' ? (selfLow ? '가장 먼저 키울 영역이에요. 다만 자기관리 점수가 낮아서, 이 영역 교육은 회복을 먼저 챙긴 뒤에 시작하는 걸 권해요.' : '교육을 고른다면 이 영역부터 살펴보면 좋아요. 아래에서 어떤 행동이 비어 있는지, 어떤 교육부터 들으면 좋을지 확인해 보세요.') : '성장 포인트 구간은 아니지만, 다른 영역보다 상대적으로 덜 하고 있는 행동이에요.') + (bottom.length > 1 ? ' 점수 차이가 0.1점도 안 돼서 모두 우선 후보로 보세요.' : '');
      hero = `<div class="hero">
        <div class="hcard good"><span class="hlabel">${tb === 'good' ? '가장 단단한 영역' : '상대적으로 나은 영역'}</span><span class="hname">${names(top)}</span><span class="hscore">${scores(top)}</span><p>${topMsg}</p></div>
        <div class="hcard low"><span class="hlabel">다음 성장 포인트</span><span class="hname">${names(bottom)}</span><span class="hscore">${scores(bottom)}</span><p>${botMsg}</p></div>
      </div>`;
    }
  }

  const excluded = reliable.length ? valid.filter(r => r.unreliable) : [];
  if (hero && excluded.length) hero += `<p class="empty">${excluded.map(r => r.d.name).join(', ')} 영역은 “해당 상황 없음”이 3개 이상이라 점수를 참고용으로만 보고, 위 비교에서는 뺐어요.</p>`;
  const legend = `<div class="crow legend"><div></div><div class="zones" aria-hidden="true"><span class="low" style="width:${pct(lo)}%">성장 포인트</span><span class="mid" style="width:${pct(hi) - pct(lo)}%">안정</span><span class="good" style="width:${100 - pct(hi)}%">강점</span></div><div></div></div>`;
  const chartRows = rows.map(({ d, st, unreliable, subs }) => {
