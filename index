function showPage(p){
  page = p;
  document.getElementById('intro').hidden = p !== 0;
  document.querySelectorAll('section.domain').forEach(s => { s.hidden = +s.dataset.page !== p; });
  document.getElementById('pager').hidden = !(p >= 1 && p <= LAST);
  document.getElementById('bar').hidden = !(p >= 1 && p <= LAST);
  document.getElementById('results').hidden = p !== LAST + 1;
  document.getElementById('refs').hidden = !(p === 0 || p === LAST + 1);
  document.getElementById('privacy').hidden = p === 0;
  document.getElementById('pdfSave').hidden = true; readyPdf = null;
  document.getElementById('pdfStatus').textContent = '';
  document.getElementById('notice').textContent = '';
  document.querySelectorAll('fieldset.item').forEach(f => f.classList.remove('missing'));
  if (p >= 1 && p <= LAST) document.getElementById('step').innerHTML = `<b>${p} / ${LAST}</b> ${DOMAINS[p - 1].name}`;
  document.getElementById('prevBtn').textContent = p === 1 ? '처음으로' : '이전';
  document.getElementById('nextBtn').textContent = p === LAST ? '결과 보기' : '다음 영역으로';
  updateProgress();
  if (p === LAST + 1) renderResults();
  window.scrollTo({ top: 0 });
  const h = p === 0 ? document.querySelector('#intro h1')
    : (p > LAST ? document.getElementById('resTitle') : document.querySelector(`section.domain[data-page="${p}"] h1`));
  if (h) { h.setAttribute('tabindex', '-1'); h.focus({ preventScroll: true }); }
}

document.getElementById('nextBtn').addEventListener('click', () => {
  const missing = itemsOf(DOMAINS[page - 1]).filter(i => !answers[i.code]);
  document.querySelectorAll('fieldset.item').forEach(f => f.classList.remove('missing'));
  if (missing.length) {
    missing.forEach(i => document.getElementById('f' + i.code).classList.add('missing'));
    document.getElementById('notice').textContent = `아직 답하지 않은 문항이 ${missing.length}개 있어요. 표시된 문항에 답해 주세요.`;
    document.getElementById('f' + missing[0].code).scrollIntoView({ behavior: 'smooth', block: 'center' });
    return;
  }
  showPage(page + 1);
});
document.getElementById('prevBtn').addEventListener('click', () => showPage(page - 1));
document.getElementById('editBtn').addEventListener('click', () => showPage(1));
document.getElementById('backBtn').addEventListener('click', () => showPage(LAST));
function startOrResume(){
  const firstOpen = DOMAINS.findIndex(d => itemsOf(d).some(i => !answers[i.code]));
  showPage(firstOpen === -1 ? LAST + 1 : firstOpen + 1);
}
document.getElementById('startBtn').addEventListener('click', startOrResume);
document.getElementById('startBtn2').addEventListener('click', startOrResume);
document.getElementById('randBtn').addEventListener('click', () => {
  ALL.forEach(i => {
    answers[i.code] = (i.na && Math.random() < 0.15) ? 'na' : String(1 + Math.floor(Math.random() * 4));
  });
  save(); syncRadios();
  showPage(LAST + 1);
});
let resetArmed = null;
function onReset(e){
  const btn = e.currentTarget;
  if (resetArmed !== btn) {
    if (resetArmed) resetArmed.textContent = '내 응답 지우기';
    resetArmed = btn;
    btn.textContent = '한 번 더 누르면 모든 응답이 지워져요';
    setTimeout(() => { if (resetArmed === btn) { resetArmed = null; btn.textContent = '내 응답 지우기'; } }, 5000);
    return;
  }
  resetArmed = null;
  btn.textContent = '내 응답 지우기';
  answers = {};
  try { localStorage.removeItem(KEY); } catch (err) {}
  syncRadios();
  showPage(0);
  document.getElementById('notice').textContent = '이 기기에 저장된 응답을 모두 지웠어요.';
}
document.getElementById('resetBtn').addEventListener('click', onReset);
